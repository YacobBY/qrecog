{"verse_key": "72:25", "surah": 72, "verse": 25, "text_uthmani": "قُلْ إِنْ أَدْرِىٓ أَقَرِيبٌ مَّا تُوعَدُونَ أَمْ يَجْعَلُ لَهُۥ رَبِّىٓ أَمَدًا", "translation": "Say, \"I do not know if what you are promised is near or if my Lord will grant for it a [long] period.\"", "verse_from_ms": 285150, "verse_to_ms": 297430, "audio_url": "https://download.quranicaudio.com/qdc/khalifah_taniji/murattal/72.mp3", "words": [{"i": 0, "text": "قُلْ", "start_ms": 285150, "end_ms": 285630}, {"i": 1, "text": "إِنْ", "start_ms": 285630, "end_ms": 286020}, {"i": 2, "text": "أَدْرِىٓ", "start_ms": 286020, "end_ms": 288260}, {"i": 3, "text": "أَقَرِيبٌ", "start_ms": 288260, "end_ms": 289360}, {"i": 4, "text": "مَّا", "start_ms": 289360, "end_ms": 290350}, {"i": 5, "text": "تُوعَدُونَ", "start_ms": 290350, "end_ms": 291520}, {"i": 6, "text": "أَمْ", "start_ms": 291520, "end_ms": 291880}, {"i": 7, "text": "يَجْعَلُ", "start_ms": 291880, "end_ms": 292630}, {"i": 8, "text": "لَهُۥ", "start_ms": 292630, "end_ms": 293290}, {"i": 9, "text": "رَبِّىٓ", "start_ms": 293290, "end_ms": 295860}, {"i": 10, "text": "أَمَدًا", "start_ms": 295860, "end_ms": 297325}]}