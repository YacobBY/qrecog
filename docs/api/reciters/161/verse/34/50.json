{"verse_key": "34:50", "surah": 34, "verse": 50, "text_uthmani": "قُلْ إِن ضَلَلْتُ فَإِنَّمَآ أَضِلُّ عَلَىٰ نَفْسِى ۖ وَإِنِ ٱهْتَدَيْتُ فَبِمَا يُوحِىٓ إِلَىَّ رَبِّىٓ ۚ إِنَّهُۥ سَمِيعٌ قَرِيبٌ", "translation": "Say, \"If I should err, I would only err against myself. But if I am guided, it is by what my Lord reveals to me. Indeed, He is Hearing and near.\"", "verse_from_ms": 1001450, "verse_to_ms": 1007720, "audio_url": "https://download.quranicaudio.com/qdc/khalifah_taniji/murattal/34.mp3", "words": [{"i": 0, "text": "قُلْ", "start_ms": 1001450, "end_ms": 1003310}, {"i": 1, "text": "إِن", "start_ms": 1003310, "end_ms": 1004840}, {"i": 2, "text": "ضَلَلْتُ", "start_ms": 1004840, "end_ms": 1007645}, {"i": 3, "text": "فَإِنَّمَآ", "start_ms": null, "end_ms": null}, {"i": 4, "text": "أَضِلُّ", "start_ms": null, "end_ms": null}, {"i": 5, "text": "عَلَىٰ", "start_ms": null, "end_ms": null}, {"i": 6, "text": "نَفْسِى", "start_ms": null, "end_ms": null}, {"i": 7, "text": "ۖ", "start_ms": null, "end_ms": null}, {"i": 8, "text": "وَإِنِ", "start_ms": null, "end_ms": null}, {"i": 9, "text": "ٱهْتَدَيْتُ", "start_ms": null, "end_ms": null}, {"i": 10, "text": "فَبِمَا", "start_ms": null, "end_ms": null}, {"i": 11, "text": "يُوحِىٓ", "start_ms": null, "end_ms": null}, {"i": 12, "text": "إِلَىَّ", "start_ms": null, "end_ms": null}, {"i": 13, "text": "رَبِّىٓ", "start_ms": null, "end_ms": null}, {"i": 14, "text": "ۚ", "start_ms": null, "end_ms": null}, {"i": 15, "text": "إِنَّهُۥ", "start_ms": null, "end_ms": null}, {"i": 16, "text": "سَمِيعٌ", "start_ms": null, "end_ms": null}, {"i": 17, "text": "قَرِيبٌ", "start_ms": null, "end_ms": null}]}